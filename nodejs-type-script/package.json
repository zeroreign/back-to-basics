{
  "name": "nodejs-with-typescript",
  "version": "1.0.0",
  "description": "Base NodeJS with TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "compile": "tsc src/* --outDir dist",
    "test": "jest --forceExit --detectOpenHandles --maxWorkers=1 --coverage",
    "test:watch": "npm run test -- --watchAll", 
    "prettier": "prettier --write src/**/*.ts",
    "lint": "eslint --ignore-path .eslintignore --ext .js,.ts",
    "lint:fix": "npm run lint --fix"
  },
  "keywords": [
    "nodejs",
    "ts",
    "typescript"
  ],
  "author": "Eddie Lam",
  "license": "ISC",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
